# Copy to .env.production. Loaded by local release builds (Xcode Archive, ./gradlew bundleRelease, run:* Release),
# which bundle JS in production mode. Overrides .env. Public values only: everything here
# ships inside the app. Fill the empty legal/support values before store submission.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_BLOCKER_CONFIG_URL=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
