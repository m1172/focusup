{
  "name": "focusup",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@posthog/react-native-plugin": "^2.12.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.4.6",
    "jest-expo": "~58.0.13",
    "posthog-react-native": "^4.81.2",
    "react": "19.3.0",
    "react-i18next": "^17.0.18",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^10.14.0",
    "react-native-purchases-ui": "^10.14.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-self": "^7.29.7",
    "@babel/plugin-transform-react-jsx-source": "^7.29.7",
    "@babel/plugin-transform-regenerator": "^7.29.8",
    "@posthog/cli": "^0.18.10",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@react-native/metro-babel-transformer": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "~29.7.0",
    "jest-expo": "^58.0.11",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "native:sync": "expo prebuild",
    "release:check": "node scripts/release-preflight.js && npm run lint && npm run typecheck && npm test && npx expo-doctor",
    "release:bump": "node scripts/bump-build.js",
    "build:ios": "xcodebuild -workspace ios/Vaqtim.xcworkspace -scheme Vaqtim -configuration Release -destination generic/platform=iOS -archivePath build/Vaqtim.xcarchive -allowProvisioningUpdates archive",
    "upload:ios": "xcodebuild -exportArchive -archivePath build/Vaqtim.xcarchive -exportOptionsPlist store/ios-export-options.plist -exportPath build/ios -allowProvisioningUpdates",
    "build:android": "cd android && ./gradlew app:bundleRelease",
    "upload:android": "npx eas-cli@latest submit --platform android --profile production --path android/app/build/outputs/bundle/release/app-release.aab --non-interactive",
    "release": "bash scripts/release.sh",
    "store:metadata": "npx eas-cli@latest metadata:push",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "backend:dev": "npm --prefix backend run dev",
    "backend:check": "npm --prefix backend run lint && npm --prefix backend run typecheck && npm --prefix backend test"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "jest-expo"
      ]
    }
  }
}
