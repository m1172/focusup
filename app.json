{
  "expo": {
    "name": "Vaqtim",
    "slug": "focusup",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "focusup",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/en.json",
      "ru": "./locales/ru.json",
      "uz": "./locales/uz.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.m1172.focusup",
      "buildNumber": "3",
      "appleTeamId": "GH6PP8FUU8",
      "infoPlist": {
        "com.posthog.posthog.CAPTURE_PUSH_NOTIFICATION_OPENED": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSCameraUsageDescription": "Allow the social website to use your camera when you choose to capture or upload media.",
        "NSMicrophoneUsageDescription": "Allow the social website to record audio when you choose a video or voice feature.",
        "NSPhotoLibraryUsageDescription": "Choose photos or videos to upload directly to the social website. Vaqtim does not upload them to its own server."
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.m1172.focusup",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#5B4FE9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "./plugins/withFocusUpProtection",
        {
          "familyControls": false
        }
      ],
      "./plugins/withAndroidReleaseSigning",
      [
        "./plugins/withAndroidAccessibility",
        {
          "enabled": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-apple-authentication",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "40dbc295-f4f0-4e25-9049-50658e8bc2d9"
      }
    },
    "owner": "m1172",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/40dbc295-f4f0-4e25-9049-50658e8bc2d9",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
