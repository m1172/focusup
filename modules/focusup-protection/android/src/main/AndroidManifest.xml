<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Onboarding reads Instagram, YouTube and TikTok screen time; granted by the user under Settings → Usage access. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>
  <queries>
    <package android:name="com.instagram.android"/><package android:name="com.google.android.youtube"/>
    <package android:name="com.zhiliaoapp.musically"/><package android:name="com.snapchat.android"/>
    <package android:name="com.twitter.android"/><package android:name="com.facebook.katana"/>
    <package android:name="com.linkedin.android"/><package android:name="com.reddit.frontpage"/>
  </queries>
  <application>
    <service android:name="expo.modules.focusupprotection.FocusUpAccessibilityService" android:exported="true" android:label="@string/focusup_protection_label" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/focusup_accessibility"/>
    </service>
    <activity android:name="expo.modules.focusupprotection.FocusUpShieldActivity" android:exported="false" android:excludeFromRecents="true" android:launchMode="singleTop" android:theme="@android:style/Theme.Material.NoActionBar"/>
  </application>
</manifest>
