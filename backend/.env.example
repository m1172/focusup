NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-legacy-anon-key
# Backend ONLY. Required for DELETE /v1/me. Never use EXPO_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=your-secret-or-legacy-service-role-key
# Exact comma-separated web origins; native apps do not need CORS.
CORS_ORIGINS=http://localhost:8081
# Set only behind a trusted proxy, e.g. loopback or the proxy's CIDR.
TRUST_PROXY=
# Optional URL allowlisted in Supabase Auth > URL Configuration.
AUTH_REDIRECT_URL=
# Enable only after configuring the corresponding providers in Supabase.
# Telegram uses an OIDC custom provider named custom:telegram.
AUTH_OAUTH_PROVIDERS=

# Only used by the explicit auth:telegram setup command; keep these server-side.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
