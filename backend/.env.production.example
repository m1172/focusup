# Reference for the hosting provider's environment settings. Keep actual values
# in the hosting dashboard or a private .env.production.local file.
NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT automatically; do not replace it with the laptop's port.
LOG_LEVEL=info

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Current sb_secret_ key, kept exclusively on the server.
SUPABASE_SECRET_KEY=

AUTH_REDIRECT_URL=focusup://auth/callback
# Set only after configuring and testing the provider in Supabase.
AUTH_OAUTH_PROVIDERS=

# Exact HTTPS web origins, if a web client is deployed. Native clients need none.
CORS_ORIGINS=
# The hosting ingress proxy IP/CIDR; verify client-IP rate limiting after deploy.
TRUST_PROXY=
