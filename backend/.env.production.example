# Reference for the hosting provider's environment settings. Keep actual values
# in the hosting dashboard or a private .env.production.local file.
NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT automatically; do not replace it with the laptop's port.
LOG_LEVEL=info

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Current sb_secret_ key, kept exclusively on the server.
SUPABASE_SECRET_KEY=

AUTH_REDIRECT_URL=focusup://auth/callback
# Set only after configuring and testing the provider in Supabase.
AUTH_OAUTH_PROVIDERS=

# Exact HTTPS web origins, if a web client is deployed. Native clients need none.
CORS_ORIGINS=
# The hosting ingress proxy IP/CIDR; verify client-IP rate limiting after deploy.
TRUST_PROXY=

# Billing stays unavailable until both secrets are set. Use SANDBOX only in a separate staging project.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENVIRONMENT=PRODUCTION
# Production counts store-sandbox purchases too: App Store and Google Play reviewers, TestFlight and licence
# testers buy in the sandbox from the production build. Set to deny only when no review or test is running.
REVENUECAT_SANDBOX_PURCHASES=allow

# Set only after staging verifies gateway overwrites the header (docs/security.md).
# EDGE_TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
