{
  "name": "vaqtim-website",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4173",
    "build": "next build && cp static/404.html out/404.html",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 -d out",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler@4.149.0 pages deploy out --project-name vaqtim --branch main"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
