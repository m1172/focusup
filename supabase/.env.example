# Copy to supabase/.env (git-ignored) before `npx supabase config push`.
# Any SMTP provider works on port 465, e.g. Resend: host smtp.resend.com, user "resend", pass = API key.
SUPABASE_AUTH_SMTP_HOST=smtp.resend.com
SUPABASE_AUTH_SMTP_USER=resend
SUPABASE_AUTH_SMTP_PASS=
# Must be an address on a domain you have verified with the provider.
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=no-reply@your-domain.com
