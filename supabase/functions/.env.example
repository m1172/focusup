# Copy into an ignored .env.local file for local function development.
# The CLI supplies SUPABASE_URL. Use current keys, not revoked legacy JWT keys.
FOCUSUP_PUBLISHABLE_KEY=
FOCUSUP_SECRET_KEY=
AUTH_REDIRECT_URL=focusup://auth/callback
AUTH_OAUTH_PROVIDERS=
CORS_ORIGINS=
# Support chat (see backend/README or `npm run support:telegram` in backend/).
# Bot token from @BotFather, the team chat id, and a random 32+ character secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
