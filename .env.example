# Add RevenueCat public SDK keys from the RevenueCat project settings.
# These are client-safe public keys. Never put RevenueCat secret keys here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Configure real HTTPS legal pages before distribution; URLs are hidden until set.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Optional FocusUp-owned JSON endpoint. It may only return validated blocker
# versions, safe selector/route data and feature kill switches; never executable code.
EXPO_PUBLIC_BLOCKER_CONFIG_URL=

# A real support inbox; issue reports open the user’s email composer.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional backend origin. Enables Settings > Your account when configured.
# Use your computer LAN IP for a physical phone during development.
EXPO_PUBLIC_API_URL=
