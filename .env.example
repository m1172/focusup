# Add RevenueCat public SDK keys from the RevenueCat project settings.
# These are client-safe public keys. Never put RevenueCat secret keys here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Configure real HTTPS legal pages before distribution; URLs are hidden until set.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Optional FocusUp-owned JSON endpoint. It may only return validated blocker
# versions, safe selector/route data and feature kill switches; never executable code.
EXPO_PUBLIC_BLOCKER_CONFIG_URL=

# A real support inbox; issue reports open the user’s email composer.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional backend base URL. Enables Settings > Your account when configured.
# Supabase: https://YOUR_PROJECT_REF.supabase.co/functions/v1/focusup-api
# A local Node API can use your computer LAN IP for phone development.
EXPO_PUBLIC_API_URL=

# PostHog public project key (phc_...). Leave blank to disable all remote tracking.
# Use https://us.i.posthog.com for a US project; the default is EU.
EXPO_PUBLIC_POSTHOG_KEY=phc_wrvoM5sFtBCDucTUM6bvVrNBoCYyweDGx7q6niRaDAuc
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_APP_ENV=development

# Optional build-time source-map/native-symbol uploads. Set these in EAS as
# build secrets; NEVER prefix a personal API key with EXPO_PUBLIC_.
# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=
# POSTHOG_CLI_HOST=https://eu.posthog.com
